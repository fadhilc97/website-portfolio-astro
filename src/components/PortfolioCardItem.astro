---
import type { PortfolioItem } from '../lib/types/content.type';

type Props = PortfolioItem;

const {
	badge,
	title,
	description,
	benefits,
	href,
	ctaLabel,
	image,
	imageAlt,
	delay,
	placeholder,
} = Astro.props;

---

<div class="bento-card portfolio-main fade-in-up" style={delay ? `--delay: ${delay}` : undefined}>
	<div class="portfolio-content">
		<span class="badge">{badge}</span>
		<h3>{title}</h3>
		<p>{description}</p>
		<ul class="benefit-list">
			{benefits.map((benefit) => <li>{benefit}</li>)}
		</ul>
		<a href={href} target="_blank" class="btn btn-outline">{ctaLabel}</a>
	</div>
	<div class="portfolio-visual">
		{
			placeholder ? (
				<div class="visual-placeholder">
					<img src={image} alt={imageAlt} class="portfolio-img" />
				</div>
			) : (
				<img src={image} alt={imageAlt} class="portfolio-img" />
			)
		}
	</div>
</div>
