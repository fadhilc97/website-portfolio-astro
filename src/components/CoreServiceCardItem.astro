---
import ServiceIcon from './ServiceIcon.astro';
import type { CoreServiceItem } from '../lib/types/content.type';

type Props = CoreServiceItem;

const { icon, title, description } = Astro.props;
---

<div class="service-item">
	<span class="service-icon"><ServiceIcon name={icon} /></span>
	<div class="service-copy">
		<h3>{title}</h3>
		<p>{description}</p>
	</div>
</div>
