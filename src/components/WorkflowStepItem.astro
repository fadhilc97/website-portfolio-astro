---
import type { WorkflowStep } from '../lib/types/content.type';

type Props = WorkflowStep;

const { number, title, description } = Astro.props;
---

<div class="step-item">
	<div class="step-number">{number}</div>
	<div class="step-body">
		<h3>{title}</h3>
		<p>{description}</p>
	</div>
</div>
