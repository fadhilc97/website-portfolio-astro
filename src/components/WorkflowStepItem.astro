---
import type { WorkflowStep } from '../lib/types/content.type';

type Props = WorkflowStep & {
	delay?: string;
};

const { number, title, description, delay } = Astro.props;
---

<div class="step-item fade-in-up" style={delay ? `--delay: ${delay}` : undefined}>
	<div class="step-number">{number}</div>
	<div class="step-body">
		<h4>{title}</h4>
		<p>{description}</p>
	</div>
</div>
