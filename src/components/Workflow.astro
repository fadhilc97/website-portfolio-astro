---
import WorkflowStepItem from './WorkflowStepItem.astro';
import type { WorkflowContent } from '../lib/types/content.type';

type Props = WorkflowContent;

const { title, items } = Astro.props;
---

<section id="alur-kerja" class="section">
	<div class="container">
		<div class="section-header reveal">
			<h2 class="section-title">{title}</h2>
		</div>

		<div class="workflow-steps">
			{items.map((item) => <WorkflowStepItem {...item} />)}
		</div>
	</div>
</section>
