---
import WorkflowStepItem from './WorkflowStepItem.astro';
import type { WorkflowContent } from '../lib/types/content.type';

type Props = WorkflowContent;

const { title, items } = Astro.props;
---

<section id="alur-kerja" class="section">
	<div class="container">
		<div class="section-header fade-in-up">
			<h2 class="section-title">{title}</h2>
		</div>

		<div class="workflow-steps">
			{
				items.map((item, index) => (
					<WorkflowStepItem {...item} delay={`${(index + 1) / 10}s`} />
				))
			}
		</div>
	</div>
</section>
