---
import PortfolioCardItem from './PortfolioCardItem.astro';
import type { PortfolioContent } from '../lib/types/content.type';

type Props = PortfolioContent;

const { title, items } = Astro.props;
---

<section id="portofolio" class="section bg-light">
	<div class="container">
		<div class="section-header reveal">
			<h2 class="section-title">{title}</h2>
		</div>

		<div class="portfolio-list">
			{items.map((item) => <PortfolioCardItem {...item} />)}
		</div>
	</div>
</section>
