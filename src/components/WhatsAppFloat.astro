---
import type { WhatsAppContent } from '../lib/types/content.type';

type Props = WhatsAppContent;

const { href, label } = Astro.props;
---

<a href={href} class="whatsapp-float" target="_blank" rel="noopener noreferrer" aria-label={label}>
	<img src="/assets/icons/whatsapp.svg" alt="" width="24" height="24" />
</a>
